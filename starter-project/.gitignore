# DB Analyst Framework — .gitignore
# Place this file at the root of your analyst project repo.

# ── Credentials & active connection config ───────────────────────────────────
# Never commit connection details or secrets.
.claude/db-connections/active.yaml
.env
.env.*
*.env
secrets.yaml
secrets.json

# ── SQLite database files ────────────────────────────────────────────────────
# Binary DB files shouldn't be in git. Use create-demo-db.sql to recreate.
*.db
*.sqlite
*.sqlite3

# ── Obsidian vault output (optional feature) ─────────────────────────────────
_obsidian-vault/

# ── OS and editor noise ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── Semantic KB index ────────────────────────────────────────────────────────
# Two-tier search index built by /db-index and kept fresh by the db-kb-reindex hook.

# kb_vectors.db — embedding vectors; non-deterministic across providers; always gitignore
.claude/kb-index/kb_vectors.db

# kb_fts.db — FTS keyword index; deterministic; small (~1-2MB for 200 tables).
# To share with your team (instant search on git pull, no rebuild needed), comment out
# this line and set rag.fts.commit_to_git: true in active.yaml.
.claude/kb-index/kb_fts.db

# git does not track empty directories, so the kb-index/ folder itself is untracked
# when both index files are ignored — this is expected.

# ── What IS committed ────────────────────────────────────────────────────────
# CLAUDE.md                                        ← project instructions
# .claude/db-connections/connections.example.yaml  ← template, safe to commit
# .claude/scripts/**                               ← connector scripts
# db-knowledge/**                                  ← the whole knowledge base
